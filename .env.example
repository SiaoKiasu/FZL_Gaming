# 环境变量清单 —— 复制成 .env.local 再填真实值。
# 这个文件只有变量名、没有任何密钥，所以它是仓库里唯一一个可以提交的 .env 文件。
# 线上的值填在 Vercel → Settings → Environment Variables（Production 和
# Preview 都要勾），改完必须 Redeploy 一次才生效，别勾 Build Cache。

# ---- 数据库 ----
# Vercel 接好 Postgres 之后会自动注入，只有本地开发才需要手填。
# 本地跑 npm run dev:local 时指向自己机器上的库，例如：
#   postgres://你的用户名@localhost:5432/fzl_dev
POSTGRES_URL=

# ---- 账号 ----
# 会话 cookie 的签名密钥。用 openssl rand -base64 32 生成一串即可。
# 换掉它等于把所有人都踢下线（现有 cookie 全部验签失败）。
SESSION_SECRET=

# 管理员口令，用来给成员设置或重置初始密码：
#   POST /api/auth/admin/set-password
# 项目没有注册流程也没有找回密码，这是唯一的开户和救济途径。
AUTH_ADMIN_PASSWORD=

# ---- 视频存储：腾讯云 COS，中国香港地域 ----
# 务必用 CAM 子账号的密钥，且权限只授予这一个桶，不要用主账号密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
# 形如 fzl-video-1300000000（末尾那串数字是 APPID）
COS_BUCKET=
COS_REGION=ap-hongkong

# ---- 峡谷基金 ----
# 首次设置账本密码时的一道管理员门槛，只在那一次用得上。
LEDGER_SETUP_ADMIN_PASSWORD=

# ---- 本地开发专用，不要配到 Vercel ----
# 由 npm run dev:local 自动设置，用于把 @vercel/postgres 换成本地 pg 驱动
# （见 src/lib/localPostgres.ts）。写在这里没有用，也不该写。
# LOCAL_PG=1
